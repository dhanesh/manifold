{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "cli/**/*.ts",
      "install/**/*.ts",
      "lib/**/*.ts",
      "scripts/**/*.ts",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/*.bundle.js",
      "!**/*.generated.ts",
      "!plugin/**",
      "!**/__tests__/**/fixtures/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
